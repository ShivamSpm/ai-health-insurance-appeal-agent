    "/api/runs/{run_id}/events": {
      "get": {
        "summary": "Run Events",
        "description": "Server-sent events: `run` (summary), `step` (one per step, id = step index),\nthen `done` (final summary with findings and letter) or `stream_error`.\n(Not `error`: EventSource uses that name for its own connection errors.)",
        "operationId": "run_events_api_runs__run_id__events_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "replay",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Replay a finished run at its recorded pace.",
              "default": false,
              "title": "Replay"
            },
            "description": "Replay a finished run at its recorded pace."
          },
          {
            "name": "speed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100,
              "exclusiveMinimum": 0,
              "description": "Replay speed multiplier.",
              "default": 1.0,
              "title": "Speed"
            },
            "description": "Replay speed multiplier."
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
