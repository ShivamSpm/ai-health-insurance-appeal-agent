                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "llm_calls": {
            "type": "integer",
            "title": "Llm Calls"
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens"
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens"
          },
          "cached_tokens": {
            "type": "integer",
            "title": "Cached Tokens"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "loaded_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Loaded Skills"
          },
          "retrieved": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Retrieved"
          },
          "findings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Findings"
              },
              {
                "type": "null"
              }
            ]
          },
          "letter": {
